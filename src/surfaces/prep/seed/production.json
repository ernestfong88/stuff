     "egg"
    ],
    [
     2,
     "tbsp",
     "parsley, chopped"
    ],
    [
     0.5,
     "tsp",
     "kosher salt"
    ],
    [
     4,
     "cups",
     "house marinara"
    ],
    [
     6,
     "leaves",
     "basil, torn"
    ]
   ],
   "method": [
    "Boil the shells 2 min short of al dente; cool on an oiled tray.",
    "Mix ricotta, half the mozzarella, the parmesan, egg, parsley and salt.",
    "Spread marinara in the hotel pan; fill each shell and set it open side up.",
    "Top with more marinara and the rest of the mozzarella; cover with foil.",
    "Bake at 375°F for 25 min, uncover for 10 until bubbling. Basil at the pass."
   ]
