 "recipes": {
  "Peach Glazed Chicken Breast": {
   "base": 8,
   "serving": "1 breast (6 oz) · 1 oz glaze",
   "ingredients": [
    [
     8,
     "",
     "boneless chicken breasts, 6 oz"
    ],
    [
     2,
     "tbsp",
     "olive oil"
    ],
    [
     2,
     "tsp",
     "kosher salt"
    ],
    [
     1,
     "tsp",
     "black pepper"
    ],
    [
     1.5,
     "cups",
     "peach preserves"
    ],
    [
     2,
     "tbsp",
     "apple cider vinegar"
    ],
    [
     1,
     "tbsp",
     "dijon mustard"
    ],
    [
     2,
     "cloves",
     "garlic, minced"
    ],
    [
     1,
     "tbsp",
     "thyme leaves"
    ]
   ],
   "method": [
    "Season the chicken on both sides; sear in oil until golden, 3 min a side.",
    "Roast at 375°F until 160°F inside, about 15 min.",
    "Simmer the preserves, vinegar, mustard, garlic and thyme until glossy, 4 min.",
    "Brush the glaze on in the last 5 min so it sets without burning.",
    "Rest 5 min; hold at 145°F or above, glaze reserved for the pass."
   ]
  },
